# AEGIS-HYBRID environment template
# Copy to .env and replace lab-specific values.
# .env itself must NEVER be committed.

# --- Telemetry ---
COWRIE_LOG_PATH=/opt/logs/cowrie.json
SURICATA_LOG_PATH=/var/log/suricata/eve.json

# --- Artifacts ---
MODEL_OUTPUT_PATH=data/ids_model.pkl
DATASET_OUTPUT_PATH=data/dataset.csv
DASHBOARD_OUTPUT_PATH=data/final_soc_output.json

# --- Optional standalone ingestion API ---
INGEST_API_KEY=change-me-to-a-long-random-value
INGEST_API_HOST=127.0.0.1
INGEST_API_PORT=5000
INGEST_RATE_LIMIT_PER_MIN=120

# --- Active response ---
ENABLE_ACTIVE_RESPONSE=false
ACTIVE_RESPONSE_ALLOWED_CIDRS=192.168.139.0/24
ACTIVE_RESPONSE_DRY_RUN=true

# --- Detection threshold ---
# Leave unset to use the validation-selected fusion threshold stored in the trained model.
# Set explicitly only when intentionally overriding it for an experiment.
# DETECTION_THRESHOLD=0.42

# --- Experimental LLM investigation ---
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=deepseek-r1:1.5b
