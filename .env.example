# =========================================================
# AEGIS-HYBRID — environment template
# Copy to .env and fill in real values.
# .env itself must NEVER be committed (see .gitignore).
# =========================================================

# --- Telemetry source paths (lab environment) ---
COWRIE_LOG_PATH=/opt/logs/cowrie.json
SURICATA_LOG_PATH=/var/log/suricata/eve.json

# --- Model & dataset paths ---
MODEL_OUTPUT_PATH=data/ids_model.pkl
DATASET_OUTPUT_PATH=data/dataset.csv
DASHBOARD_OUTPUT_PATH=data/final_soc_output.json

# --- Ingestion API (ingestion/ingest_api.py) ---
# Required: shared-secret API key clients must send as header
#   X-API-Key: <value>
INGEST_API_KEY=change-me-to-a-long-random-value
INGEST_API_HOST=127.0.0.1
INGEST_API_PORT=5000
# Max requests per IP per minute (simple in-memory limiter)
INGEST_RATE_LIMIT_PER_MIN=120

# --- Active response (pipeline/offline_pipeline.py) ---
# Active response is DISABLED by default. Only set to "true"
# in an isolated lab network. See core/active_response.py.
ENABLE_ACTIVE_RESPONSE=false
# Comma-separated CIDR allowlist of ranges that MAY be blocked
# (defense-in-depth: never block outside the lab subnet)
ACTIVE_RESPONSE_ALLOWED_CIDRS=192.168.139.0/24
# If true, log the iptables command instead of executing it
ACTIVE_RESPONSE_DRY_RUN=true

# --- Detection thresholds ---
DETECTION_THRESHOLD=0.42

# --- LLM investigation (experimental/llm_analysis.py) ---
# Optional. Leave blank to disable this module entirely.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=deepseek-r1:1.5b
